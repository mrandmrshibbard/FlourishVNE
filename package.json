{
  "name": "flourish-visual-novel-engine",
  "private": true,
  "version": "2.8.5",
  "description": "Flourish Visual Novel Engine",
  "author": "Memento_Morii",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:standalone": "vite build --config vite.config.standalone.ts",
    "generate:engine-bundle": "node scripts/generate-engine-bundle.js",
    "stage:build-tools": "node scripts/stage-build-tools.cjs",
    "build:engine": "npm run build:standalone && npm run generate:engine-bundle",
    "build:player": "node scripts/build-player.js",
    "build:full": "npm run build:engine && npm run build",
    "electron:dev": "npm run build:full && electron .",
    "electron:dev:nogpu": "npm run build:full && electron . --disable-gpu --disable-gpu-compositing",
    "electron:build": "npm run stage:build-tools && npm run build:full && electron-builder",
    "electron:build:win": "npm run stage:build-tools && npm run build:full && electron-builder --win",
    "electron:build:mac": "npm run stage:build-tools && npm run build:full && electron-builder --mac",
    "electron:build:linux": "npm run stage:build-tools && npm run build:full && electron-builder --linux",
    "dist": "npm run stage:build-tools && npm run build:full && electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "i18next": "^26.3.0",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jsdom": "^28.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.flourish.vne",
    "productName": "Flourish Visual Novel Engine",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "mrandmrshibbard",
      "repo": "FlourishVNE-releases"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-tools",
        "to": "build-tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/Flourish.png",
      "artifactName": "Flourish-VNE-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flourish Visual Novel Engine",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "public/Flourish.png",
      "uninstallerIcon": "public/Flourish.png",
      "installerHeaderIcon": "public/Flourish.png"
    },
    "fileAssociations": [
      {
        "ext": "flourish",
        "name": "Flourish Visual Novel Engine Project",
        "description": "Flourish Visual Novel Engine Project",
        "mimeType": "application/x-flourish-project",
        "icon": "public/Flourish.png",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/Flourish.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "public/Flourish.png"
    }
  }
}
