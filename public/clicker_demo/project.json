{
  "id": "proj-clicker-demo",
  "title": "Clicker Demo — Pet the Grump",
  "startSceneId": "scene-start",
  "scenes": {
    "scene-start": {
      "id": "scene-start",
      "name": "Pet the Grump",
      "commands": [
        {
          "id": "c-00n",
          "type": "SetBackground",
          "backgroundId": "bg-room",
          "transition": "fade",
          "duration": 1,
          "modifiers": {}
        },
        {
          "id": "c-00o",
          "type": "ShowCharacter",
          "characterId": "char-alana",
          "expressionId": "e-a-idle",
          "position": "right",
          "transition": "fade",
          "duration": 0.5,
          "modifiers": {}
        },
        {
          "id": "c-00p",
          "type": "Dialogue",
          "characterId": "char-alana",
          "text": "See him? That’s Que. Resident grump. Hasn’t smiled since… hm. Ever?",
          "modifiers": {}
        },
        {
          "id": "c-00q",
          "type": "ShowCharacter",
          "characterId": "char-que",
          "expressionId": "e-pouty",
          "position": "center",
          "transition": "fade",
          "duration": 0.5,
          "modifiers": {}
        },
        {
          "id": "c-00r",
          "type": "Dialogue",
          "characterId": "char-que",
          "text": "What do YOU want?",
          "modifiers": {}
        },
        {
          "id": "c-00s",
          "type": "Dialogue",
          "characterId": "char-alana",
          "text": "I bet he's really a big softy... maybe if you pat him, he'll open up! Click him and try it!",
          "modifiers": {}
        },
        {
          "id": "c-00m",
          "type": "ShowHotSpot",
          "name": "Pet Que",
          "shape": "rect",
          "trigger": "click",
          "x": 38,
          "y": 6,
          "width": 24,
          "height": 86,
          "hoverCursor": "hand",
          "visible": false,
          "advanceOnTrigger": false,
          "actions": [
            {
              "type": "CallCommonEvent",
              "commonEventId": "ce-pet"
            }
          ],
          "modifiers": {}
        },
        {
          "id": "c-00t",
          "type": "Label",
          "labelId": "petting1",
          "modifiers": {}
        },
        {
          "id": "c-00u",
          "type": "Wait",
          "duration": 0,
          "waitForCondition": true,
          "waitConditions": [
            {
              "variableId": "v-stage",
              "operator": ">=",
              "value": 2
            }
          ],
          "modifiers": {}
        },
        {
          "id": "c-00v",
          "type": "BranchStart",
          "name": "Still stage 1?",
          "color": "#79b8e8",
          "branchId": "branch-hold1",
          "conditions": [
            {
              "variableId": "v-stage",
              "operator": "<",
              "value": 2
            }
          ],
          "modifiers": {}
        },
        {
          "id": "c-00w",
          "type": "JumpToLabel",
          "labelId": "petting1",
          "modifiers": {}
        },
        {
          "id": "c-00x",
          "type": "BranchEnd",
          "branchId": "branch-hold1",
          "modifiers": {}
        },
        {
          "id": "c-00y",
          "type": "Dialogue",
          "characterId": "char-que",
          "text": "Hm. That’s… not TOO bad...",
          "modifiers": {}
        },
        {
          "id": "c-00z",
          "type": "Label",
          "labelId": "petting2",
          "modifiers": {}
        },
        {
          "id": "c-010",
          "type": "Wait",
          "duration": 0,
          "waitForCondition": true,
          "waitConditions": [
            {
              "variableId": "v-stage",
              "operator": ">=",
              "value": 3
            }
          ],
          "modifiers": {}
        },
        {
          "id": "c-011",
          "type": "BranchStart",
          "name": "Still stage 2?",
          "color": "#79b8e8",
          "branchId": "branch-hold2",
          "conditions": [
            {
              "variableId": "v-stage",
              "operator": "<",
              "value": 3
            }
          ],
          "modifiers": {}
        },
        {
          "id": "c-012",
          "type": "JumpToLabel",
          "labelId": "petting2",
          "modifiers": {}
        },
        {
          "id": "c-013",
          "type": "BranchEnd",
          "branchId": "branch-hold2",
          "modifiers": {}
        },
        {
          "id": "c-014",
          "type": "HideHotSpot",
          "targetCommandId": "c-00m",
          "modifiers": {}
        },
        {
          "id": "c-015",
          "type": "PlayCharacterAnimation",
          "characterId": "char-que",
          "animationId": null,
          "modifiers": {}
        },
        {
          "id": "c-016",
          "type": "Dialogue",
          "characterId": "char-que",
          "text": "...Wait! Don't stop...",
          "modifiers": {}
        },
        {
          "id": "c-017",
          "type": "SetCharacterLayer",
          "characterId": "char-alana",
          "layers": [
            {
              "layerId": "l-abody",
              "assetId": "a-blush"
            }
          ],
          "duration": 0.3,
          "modifiers": {}
        },
        {
          "id": "c-018",
          "type": "Dialogue",
          "characterId": "char-alana",
          "text": "I have NEVER seen that face on him before!",
          "modifiers": {}
        },
        {
          "id": "c-019",
          "type": "Dialogue",
          "characterId": null,
          "text": "Que isn't grumpy anymore! It took {Clicks} pats and gave {Affection} affection (later stages reward more per pat).",
          "modifiers": {}
        },
        {
          "id": "c-01a",
          "type": "Dialogue",
          "characterId": "char-alana",
          "text": "Check the editor and see how it's done!",
          "modifiers": {}
        }
      ]
    }
  },
