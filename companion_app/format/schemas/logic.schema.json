{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flourishvne.dev/vnbundle/0.1.0/logic.schema.json",
  "title": "vnbundle logic (common events)",
  "type": "object",
  "properties": {
    "commonEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "commands"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
          "name": { "type": "string" },
          "commands": { "type": "array" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
