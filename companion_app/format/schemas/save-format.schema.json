{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flourishvne.dev/vnbundle/0.1.0/save-format.schema.json",
  "title": "vnbundle save schema",
  "type": "object",
  "required": ["save_schema_version", "persist"],
  "properties": {
    "save_schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "persist": {
      "type": "object",
      "properties": {
        "position": { "type": "boolean" },
        "variables": {
          "type": "object",
          "properties": {
            "scopes": {
              "type": "array",
              "items": { "enum": ["local", "global", "persistent"] }
            }
          },
          "additionalProperties": false
        },
        "visitedScenes": { "type": "boolean" },
        "playTime": { "type": "boolean" },
        "stage": { "type": "boolean" },
        "music": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "persistentVariablesSeparate": { "type": "boolean" },
    "slots": {
      "type": "object",
      "properties": {
        "count": { "type": "number", "minimum": 1 },
        "autosave": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
