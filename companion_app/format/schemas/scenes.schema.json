{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flourishvne.dev/vnbundle/0.1.0/scenes.schema.json",
  "title": "vnbundle scenes",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "commands"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
        "name": { "type": "string" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "outTransition": { "$ref": "#/$defs/transition" }
      },
      "additionalProperties": false
    },

    "condition": {
      "type": "object",
      "required": ["var", "op"],
      "properties": {
        "var": { "type": "string" },
        "op": { "enum": ["==", "!=", ">", "<", ">=", "<=", "is true", "is false", "contains", "startsWith"] },
        "value": {},
        "join": { "enum": ["and", "or"] }
      },
      "additionalProperties": false
    },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },

    "varSet": {
      "type": "object",
      "required": ["var"],
      "properties": {
        "var": { "type": "string" },
        "op": { "enum": ["set", "add", "subtract", "multiply", "divide", "toggle"] },
        "value": {}
      },
      "additionalProperties": false
    },

    "action": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["setVar", "resetVar", "jumpToScene", "jumpToLabel", "playMusic", "stopMusic", "playSound", "stopSound", "showScreen", "save", "load", "deleteSave"] },
        "if": { "$ref": "#/$defs/conditions" }
      },
      "additionalProperties": true
    },

    "transition": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "durationMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "choiceOption": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "if": { "$ref": "#/$defs/conditions" },
        "goto": { "type": "string" },
        "gotoLabel": { "type": "string" },
        "set": { "type": "array", "items": { "$ref": "#/$defs/varSet" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },

    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "say", "choice", "set", "jump", "label", "jumpToLabel", "branch", "callCommonEvent",
            "wait", "group", "textInput",
            "showCharacter", "hideCharacter", "setCharacterSprite", "moveCharacter", "setBackground",
            "playMusic", "stopMusic", "playSound", "stopSound",
            "showImage", "hideImage", "showText", "hideText", "showButton", "hideButton",
            "showHotSpot", "hideHotSpot", "tween", "creditRoll", "playMovie", "stopMovie",
            "shakeScreen", "tintScreen", "panZoomScreen", "resetScreenEffects", "flashScreen",
            "setScreenOverlay", "spawnParticles", "stopParticles", "lightning", "flashlight",
            "fireworks", "placeLights", "clearLights", "showScreen", "setTimeOfDay"
          ]
        },
        "if": { "$ref": "#/$defs/conditions" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "say" } } },
          "then": { "required": ["text"], "properties": { "text": { "type": "string" }, "speaker": { "type": ["string", "null"] }, "name": { "type": "string" }, "voice": { "type": "string" }, "effects": { "type": "array" } } } },
        { "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["options"], "properties": { "prompt": { "type": "string" }, "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/choiceOption" } } } } },
        { "if": { "properties": { "type": { "const": "set" } } },
          "then": { "required": ["var"], "properties": { "var": { "type": "string" }, "op": { "enum": ["set", "add", "subtract", "multiply", "divide", "toggle"] }, "value": {} } } },
        { "if": { "properties": { "type": { "const": "jump" } } },
          "then": { "required": ["scene"], "properties": { "scene": { "type": "string" }, "atLabel": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "label" } } },
          "then": { "required": ["name"], "properties": { "name": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "jumpToLabel" } } },
          "then": { "required": ["label"], "properties": { "label": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "branch" } } },
          "then": { "required": ["branches"], "properties": { "branches": { "type": "array", "items": { "$ref": "#/$defs/branchArm" } } } } },
        { "if": { "properties": { "type": { "const": "callCommonEvent" } } },
          "then": { "required": ["event"], "properties": { "event": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "textInput" } } },
          "then": { "required": ["var"], "properties": { "var": { "type": "string" }, "prompt": { "type": "string" }, "maxLength": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "showCharacter" } } },
          "then": { "required": ["character"], "properties": { "character": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "setBackground" } } },
          "then": { "properties": { "image": { "type": ["string", "null"] } } } },
        { "if": { "properties": { "type": { "const": "playMusic" } } },
          "then": { "required": ["audio"], "properties": { "audio": { "type": "string" } } } }
      ]
    },

    "branchArm": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "if": { "$ref": "#/$defs/conditions" },
        "else": { "type": "boolean" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "additionalProperties": false
    }
  }
}
