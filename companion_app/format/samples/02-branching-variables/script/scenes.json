{
  "scenes": [
    {
      "id": "intro",
      "name": "Intro",
      "commands": [
        { "id": "n1", "type": "say", "text": "A stranger blocks the path." },
        { "id": "c1", "type": "choice", "prompt": "What do you do?", "options": [
          { "text": "Say hi", "set": [ { "var": "met_yuki", "value": true } ], "goto": "greet" },
          { "text": "Push past (needs courage)", "if": [ { "var": "brave", "op": ">", "value": 2 } ], "goto": "leave" },
          { "text": "Steel yourself", "set": [ { "var": "brave", "op": "add", "value": 1 } ] }
        ] }
      ]
    },
    {
      "id": "greet",
      "name": "Greeting",
      "commands": [
        { "id": "b1", "type": "branch", "branches": [
          { "if": [ { "var": "met_yuki", "op": "is true" } ], "commands": [
            { "id": "g1", "type": "say", "text": "You wave. They smile back." }
          ] },
          { "else": true, "commands": [
            { "id": "g2", "type": "say", "text": "You hesitate, unsure." }
          ] }
        ] },
        { "id": "j1", "type": "jumpToLabel", "label": "end_greet", "if": [ { "var": "met_yuki", "op": "is true" } ] },
        { "id": "g_hes", "type": "say", "text": "You linger a moment too long." },
        { "id": "lbl", "type": "label", "name": "end_greet" },
        { "id": "s1", "type": "set", "var": "brave", "op": "add", "value": 1 },
        { "id": "g3", "type": "say", "text": "You feel a little braver." }
      ]
    },
    {
      "id": "leave",
      "name": "Leaving",
      "commands": [
        { "id": "l1", "type": "say", "text": "You slip past without a word." }
      ]
    }
  ]
}
